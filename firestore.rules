rules_version = '2';

// Data model
//   companies/{cid}                 { name, modules: { market, cost, signal, advisory }, validUntil }
//   companies/{cid}/members/{uid}   { email, role: owner | analyst | viewer }  → mirrored into auth claims { cid, role }
//   companies/{cid}/profiles/{pid}  saved consumption profiles and results
//   market/{series}/months/{ym}     market data, written only by Cloud Functions
//   settings/app                    { authRequired }  → while not true, everyone is treated as admin (pre-launch testing)
//   admins/{uid}                    { email }  list of Metis admins, written by Cloud Functions
//   companies/{cid}/notes|contracts|invoices   mini CRM, Metis admins only
//   trialRequests/{id}              public 14-day trial requests from the landing page; admins approve (approveTrial)
// Metis staff carry the auth claim { admin: true }.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function openMode() {
      return !exists(/databases/$(database)/documents/settings/app)
        || get(/databases/$(database)/documents/settings/app).data.get('authRequired', false) != true;
    }
    function isAdmin() { return (signedIn() && request.auth.token.admin == true) || openMode(); }

    match /settings/app {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }
    function inCompany(cid) { return signedIn() && request.auth.token.cid == cid; }
    function canEdit() { return request.auth.token.role in ['owner', 'analyst']; }
    function isOwner(cid) { return inCompany(cid) && request.auth.token.role == 'owner'; }
    function company() { return get(/databases/$(database)/documents/companies/$(request.auth.token.cid)).data; }
    function hasModule(m) {
      return signedIn() && request.auth.token.cid is string
        && company().modules.get(m, false) == true
        && (company().get('validUntil', null) == null || company().validUntil > request.time);
    }

    match /companies/{cid} {
      allow read: if isAdmin() || inCompany(cid);
      allow write: if isAdmin();

      // Owners add members through the createMember function (it enforces the seat limit).
      // Owners may change a colleague's role (analyst/viewer) or remove them, never another owner or themselves.
      match /members/{uid} {
        allow read: if isAdmin() || inCompany(cid);
        allow create: if isAdmin();
        allow update: if isAdmin() || (isOwner(cid) && uid != request.auth.uid && resource.data.role != 'owner'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['analyst', 'viewer']);
        allow delete: if isAdmin() || (isOwner(cid) && uid != request.auth.uid && resource.data.role != 'owner');
      }

      // Mini CRM: notes, contracts and invoices per client, Metis staff only.
      match /notes/{id} { allow read, write: if isAdmin(); }
      match /contracts/{id} { allow read, write: if isAdmin(); }
      match /invoices/{id} { allow read, write: if isAdmin(); }

      match /profiles/{pid} {
        allow read: if isAdmin() || (inCompany(cid) && hasModule('cost'));
        allow create, update: if isAdmin() || (inCompany(cid) && canEdit() && hasModule('cost')
          && request.resource.data.createdBy == request.auth.uid);
        allow delete: if isAdmin() || (inCompany(cid) && canEdit());
      }

      // Advisory requests: client opens one, both sides append to the thread.
      match /requests/{rid} {
        allow read: if isAdmin() || (inCompany(cid) && hasModule('advisory'));
        allow create: if isAdmin() || (inCompany(cid) && canEdit() && hasModule('advisory')
          && request.resource.data.createdBy == request.auth.uid && request.resource.data.thread.size() == 1);
        allow update: if isAdmin() || (inCompany(cid) && canEdit() && hasModule('advisory')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['thread', 'updatedAt'])
          && request.resource.data.thread.size() == resource.data.thread.size() + 1);
        allow delete: if isAdmin();
      }
    }

    match /{path=**}/requests/{rid} {
      allow read: if isAdmin();
    }

    // Market feeds: written only by Cloud Functions.
    match /market/{doc=**} {
      allow read: if isAdmin() || hasModule('market');
      allow write: if false;
    }

    // Admin-managed series. 'display' may be shown to clients; 'derived' and 'internal' never leave the server/admins.
    match /series/{sid} {
      allow read: if isAdmin() || (hasModule('market') && resource.data.licence == 'display');
      allow write: if false;
      match /versions/{v} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // API tokens and feed credentials: admins may set them, nobody can read them back.
    match /secrets/{id} {
      allow read: if false;
      allow write: if isAdmin();
    }

    // Formula parameters, upload template, public texts. config/email (sender, alert recipients) is admins only.
    match /config/{id} {
      allow read: if id != 'email' || isAdmin();
      allow write: if isAdmin();
    }

    // Email audit log: written by Cloud Functions only.
    match /mailLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /content/{page} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 14-day trial requests: anyone may file one (shape checked here), only admins read or decide.
    // ponytail: no rate limit; add App Check or a callable with reCAPTCHA if the form gets spammed.
    match /trialRequests/{id} {
      function str(k, lo, hi) { return request.resource.data.get(k, '') is string && request.resource.data.get(k, '').size() >= lo && request.resource.data.get(k, '').size() <= hi; }
      allow create: if request.resource.data.keys().hasOnly(['company', 'name', 'email', 'phone', 'message', 'lang', 'status', 'createdAt'])
        && request.resource.data.status == 'new' && request.resource.data.createdAt == request.time
        && str('company', 2, 120) && str('name', 1, 120) && str('email', 5, 200) && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && str('phone', 0, 40) && str('message', 0, 2000) && request.resource.data.get('lang', 'el') in ['el', 'en'];
      allow read, update, delete: if isAdmin();
    }

    // Buy-or-Wait signals published by Metis.
    match /signals/{id} {
      allow read: if isAdmin() || hasModule('signal');
      allow write: if isAdmin();
    }
  }
}
